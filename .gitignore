# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Packaging and test artifacts
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (keep the documented template)
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter temporary files
.ipynb_checkpoints/
*.nbconvert.ipynb

# Local datasets (keep directory placeholders)
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep

# Trained model artifacts (keep the top-level directory placeholder)
/models/*
!/models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.h5
*.keras
